#!/usr/bin/env bash
set -eu
root="${G8D_CONFIG_DIR:-$HOME/.config/hyprland-g8d}"
log="$HOME/.local/state/hyprland-g8d"
mkdir -p "$log"
exec >>"$log/autostart.log" 2>&1
if [[ "${G8D_PREVIEW:-0}" != 1 ]]; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE HYPRLAND_INSTANCE_SIGNATURE QT_QPA_PLATFORMTHEME || true
fi
pids=()
cleanup() {
    for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
}
trap cleanup EXIT
trap 'exit 0' TERM INT
spawn() { "$@" & pids+=("$!"); }
start_wallpaper() {
    python3 "$root/plugins/appearance.py" start &
    local startup=$!
    trap 'kill "$startup" 2>/dev/null || true; exit 0' TERM INT
    if ! wait "$startup"; then
        echo 'Wallpaper startup failed; using a solid background.' >&2
        exec env G8D_WALLPAPER=1 G8D_WALLPAPER_OUTPUT= swaybg -c '#161b20'
    fi
}
spawn waybar -c "$root/waybar.json" -s "$root/waybar.css"
spawn python3 "$root/plugins/panels.py"
spawn mako -c "$root/mako.conf"
spawn hypridle -c "$root/hypridle.conf"
spawn start_wallpaper
if [[ "${G8D_PREVIEW:-0}" != 1 ]]; then
    spawn /usr/lib/hyprpolkitagent/hyprpolkitagent
    # Translate legacy X11 tray icons (Qt/XEmbed, Wine) into StatusNotifier items.
    if command -v xembedsniproxy >/dev/null && ! pgrep -u "$UID" -x xembedsniproxy >/dev/null; then
        spawn env QT_QPA_PLATFORM=xcb xembedsniproxy
    fi
fi
# Remain attached to this compositor, then clean up only our own child processes.
while hyprctl -j monitors >/dev/null 2>&1; do sleep 3; done
