* {
    font: "DejaVu Sans 11";
    bg: #161b20;
    fg: #dbe1e5;
    muted: #7a8792;
    accent: #6faede;
    background-color: transparent;
    text-color: @fg;
}
window { width: 480px; border: 1px; border-color: #303b43; border-radius: 10px; background-color: @bg; padding: 18px; }
mainbox { spacing: 14px; children: [ inputbar, listview ]; }
inputbar { spacing: 10px; padding: 8px 6px 14px; border: 0px 0px 1px; border-color: #303b43; children: [ prompt, entry ]; }
prompt { text-color: @accent; }
entry { placeholder: "Поиск приложений…"; placeholder-color: @muted; }
listview { lines: 7; fixed-height: false; scrollbar: false; spacing: 4px; }
element { padding: 10px; border-radius: 6px; spacing: 10px; }
element selected.normal { background-color: #212f3a; text-color: @accent; }
element-icon { size: 22px; }
element-text { vertical-align: 0.5; }
