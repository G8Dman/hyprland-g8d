configuration { display-drun: "Приложения"; }
* {
    font: "Roboto 12";
    outline: #35454b;
    container: #222c32;
    selected: #263638;
    bg: #161b20;
    fg: #dbe1e5;
    muted: #7a8792;
    accent: #8bbfba;
    background-color: transparent;
    text-color: @fg;
}
window { width: 600px; border: 1px; border-color: @outline; border-radius: 28px; background-color: @bg; padding: 16px; }
mainbox { spacing: 12px; children: [ inputbar, listview ]; }
inputbar { spacing: 12px; padding: 16px; border-radius: 20px; background-color: @container; children: [ prompt, entry ]; }
prompt { text-color: @accent; }
entry { placeholder: "Поиск приложений…"; placeholder-color: @muted; }
listview { lines: 7; fixed-height: false; scrollbar: false; spacing: 4px; }
element { padding: 14px 16px; border-radius: 16px; spacing: 16px; }
element selected.normal { background-color: @selected; text-color: @accent; }
element-icon { size: 28px; }
element-text { vertical-align: 0.5; }
