* {
    font: "DejaVu Sans 11";
    bg: #f9fbfdf5;
    fg: #263544;
    muted: #64778a;
    accent: #8bbfba;
    background-color: transparent;
    text-color: @fg;
}
window { width: 480px; border: 1px; border-color: #d4dee7; border-radius: 14px; background-color: @bg; padding: 18px; }
mainbox { spacing: 14px; children: [ inputbar, listview ]; }
inputbar { spacing: 10px; padding: 8px 6px 14px; border: 0px 0px 1px; border-color: #d4dee7; children: [ prompt, entry ]; }
prompt { text-color: @accent; }
entry { placeholder: "Поиск приложений…"; placeholder-color: @muted; }
listview { lines: 7; fixed-height: false; scrollbar: false; spacing: 4px; }
element { padding: 10px; border-radius: 6px; spacing: 10px; }
element selected.normal { background-color: #e2edf7; text-color: @accent; }
element-icon { size: 22px; }
element-text { vertical-align: 0.5; }
